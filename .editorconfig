root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{json,yml,yaml,csproj,props}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_readonly_field = true:warning
# Unused usings fail the build (IDE0005 requires GenerateDocumentationFile in some SDKs; kept as suggestion).
dotnet_diagnostic.IDE0005.severity = suggestion
# Test method names use underscores by convention (Method_Scenario_Expected).
dotnet_diagnostic.CA1707.severity = none

# EF Core migrations are generated code: excluded from style enforcement and formatting.
[**/Migrations/**.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
