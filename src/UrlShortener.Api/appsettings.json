{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": true
  },
  "ConnectionStrings": {
    "Links": "Data Source=urlshortener.db"
  },
  "Shortener": {
    "PublicBaseUrl": "http://localhost:5080",
    "MaxCodeGenerationAttempts": 5,
    "StatsWindowDays": 30
  },
  "Auth": {
    "ApiKeys": []
  }
}
